<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".features.dev.ContactGeneratorActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_material_dark"
        android:minHeight="?attr/actionBarSize"
        app:titleTextColor="@android:color/white">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/title_activity_contact_generator"
            android:textColor="@color/color_almost_white"
            android:textSize="@dimen/text_title2" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Shown until READ_CONTACTS and WRITE_CONTACTS are granted -->
    <LinearLayout
        android:id="@+id/layout_need_permissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/unit_l"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/unit_xl"
            android:drawableTop="@mipmap/ic_launcher"
            android:drawablePadding="@dimen/unit_l"
            android:gravity="center"
            android:text="@string/str_need_write_contact_permissions" />

        <Button
            android:id="@+id/btn_request_permissions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/unit_l"
            android:backgroundTint="@color/colorAccent"
            android:text="@string/str_btn_request_permissions" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_generator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/unit_l"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/str_contact_generator_info" />

        <Button
            android:id="@+id/btn_generate_contacts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/unit_xl"
            android:backgroundTint="@color/colorAccent"
            tools:text="Create 100 Contacts" />

        <Button
            android:id="@+id/btn_remove_contacts"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/unit_m"
            android:text="@string/str_btn_remove_generated_contacts" />

        <ProgressBar
            android:id="@+id/progress_generate"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/unit_l"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/text_generator_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/unit_m"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
